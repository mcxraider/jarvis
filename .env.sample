# Jarvis runtime configuration
# Copy this file to .env and replace placeholders with real values.

# Telegram bot token from @BotFather.
BOT_TOKEN=1234567890:replace_with_telegram_bot_token

# Public HTTPS URL that points to this backend, usually from ngrok during local dev.
# Example: https://abc123.ngrok-free.app
NGROK_URL=https://your-ngrok-url.ngrok-free.app

# Secret used by the webhook route: POST /webhook/:secret
# Use any long random string. It must match the Telegram webhook URL path.
TELEGRAM_SECRET_TOKEN=replace_with_random_webhook_secret

# Comma-separated Telegram user IDs allowed to use the bot.
ALLOWED_TELEGRAM_USER_IDS=replace_with_allowed_telegram_user_ids

# DeepSeek API key used for chat completions and tool calling.
DEEPSEEK_API_KEY=sk-replace_with_deepseek_api_key

# Groq API key used for audio transcription (whisper-large-v3).
GROQ_API_KEY=gsk-replace_with_groq_api_key

# Todoist REST API token.
TODOIST_API_KEY=replace_with_todoist_api_key

# Local server port. Defaults to 3000 if unset.
PORT=3000

# development | production
NODE_ENV=development

# Optional: override the default model. GPTService defaults to deepseek-v4-flash.
# DEEPSEEK_MODEL=deepseek-v4-flash

# Optional LangSmith tracing for the Python LangGraph runner in agents/jarvis.py.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_replace_with_langsmith_api_key
LANGSMITH_PROJECT=jarvis-langgraph-local
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Optional logging controls.
# LOG_FORMAT=pretty is easier to read locally; LOG_FORMAT=json is better for machines.
LOG_LEVEL=debug
LOG_FORMAT=pretty


# Test configuration
# Normal unit tests do not require live credentials:
# npm test -- --runInBand

# Live Telegram smoke tests:
# RUN_INTEGRATION_TESTS=true npm run test:integration -- --runInBand
RUN_INTEGRATION_TESTS=false

# Your Telegram chat ID for live Telegram send-message tests.
# You can get this from Telegram APIs or bot update payloads.
TEST_CHAT_ID=123456789

# Your Telegram user ID for live webhook-shaped update tests.
TEST_USER_ID=123456789

# Live Todoist CRUD tests:
# RUN_LIVE_TODOIST_TESTS=true npm run test:integration -- --runInBand
RUN_LIVE_TODOIST_TESTS=false

# Live OpenAI + Todoist pipeline tests:
# RUN_LIVE_OPENAI_TODOIST_TESTS=true npm run test:integration -- --runInBand
RUN_LIVE_OPENAI_TODOIST_TESTS=false

# Live webhook tests:
# Requires the backend to be running and NGROK_URL to route to it.
# RUN_LIVE_WEBHOOK_TESTS=true npm run test:integration -- --runInBand
RUN_LIVE_WEBHOOK_TESTS=false


venv/
