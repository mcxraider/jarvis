# Jarvis runtime configuration
# Copy this file to .env and replace placeholders with real values.

# Telegram bot token from @BotFather.
BOT_TOKEN=1234567890:replace_with_telegram_bot_token

# Public HTTPS URL that points to this backend, usually from ngrok during local dev.
# Example: https://abc123.ngrok-free.app
NGROK_URL=https://your-ngrok-url.ngrok-free.app

# Optional ngrok auth token, used if local scripts start/configure ngrok for you.
NGROK_AUTH_TOKEN=replace_with_ngrok_auth_token

# Secret used by the webhook route: POST /webhook/:secret
# Use any long random string. It must match the Telegram webhook URL path.
TELEGRAM_SECRET_TOKEN=replace_with_random_webhook_secret

# Telegram access is resolved from active, verified rows in users and
# user_identities. This optional emergency deny-list overrides database access.
# TELEGRAM_EMERGENCY_DENY_USER_IDS=111111111,222222222

# Temporary local CLI aliases for testing per-user Todoist routing.
# These power: npm run agent -- --user-1 / --user-2
JARVIS_CLI_USER_1_TELEGRAM_ID=111111111
JARVIS_CLI_USER_2_TELEGRAM_ID=222222222

# Default CLI identity when no --user flag is passed, so `runner.py "..."` resolves
# integrations from Supabase instead of falling back to keyless offline mode.
# Requires JARVIS_POSTGRES_DSN to be set.
JARVIS_CLI_DEFAULT_TELEGRAM_ID=111111111

# Opt-in Telegram Rich Messages (Bot API 10.1). Set to "true" to deliver final
# replies and progress streaming as rich messages. Anything else keeps MarkdownV2.
TELEGRAM_RICH_MESSAGES=true

# Python LangGraph Agent API called by the TypeScript Telegram service.
LANGGRAPH_AGENT_URL=http://localhost:8000
# Supports narrated foreground runs through two minutes; keep any webhook/proxy
# request timeout above this value too.
LANGGRAPH_AGENT_TIMEOUT_MS=150000
# Optional shared secret. If set on the Python service, set the same value here.
# LANGGRAPH_AGENT_API_KEY=replace_with_random_agent_api_key

# Durable Telegram clarification routing. Use Postgres in production so replies
# after restarts resume the same LangGraph thread.
# Defaults to postgres when DATABASE_URL or JARVIS_POSTGRES_DSN is set; otherwise memory.
# JARVIS_POSTGRES_DSN=postgresql://user:password@host:6543/postgres
# Keep false for the normal runtime role. Enable only for a one-time launch with
# a privileged DSN when LangGraph checkpoint tables must be created or upgraded.
# JARVIS_RUN_CHECKPOINT_SETUP=false
# Admin-only integration importer. Use a separate login inheriting
# jarvis_admin_runtime; never expose this DSN to the bot process in production.
# JARVIS_ADMIN_POSTGRES_DSN=postgresql://admin:password@host:6543/postgres
# JARVIS_IDEMPOTENCY_REQUEST_TTL_SECONDS=14400
# JARVIS_IDEMPOTENCY_OPERATION_TTL_SECONDS=7200
# JARVIS_IDEMPOTENCY_LEASE_SECONDS=60
# JARVIS_IDEMPOTENCY_WAIT_SECONDS=30
# JARVIS_IDEMPOTENCY_POLL_INTERVAL_SECONDS=0.1
# JARVIS_IDEMPOTENCY_CLEANUP_INTERVAL_SECONDS=1800
# TELEGRAM_PENDING_STORE=postgres
# TELEGRAM_PENDING_POSTGRES_DSN=postgres://user:password@localhost:5432/jarvis
# TELEGRAM_PENDING_TTL_MS=1800000

# Groq API key used for audio transcription (whisper-large-v3).
GROQ_API_KEY=gsk-replace_with_groq_api_key
# Explicit, latency-bounded Groq retry policy. The SDK's internal retries are disabled.
# GROQ_TRANSCRIPTION_REQUEST_TIMEOUT_SECONDS=12
# GROQ_TRANSCRIPTION_MAX_RETRY_ATTEMPTS=2
# GROQ_TRANSCRIPTION_RETRY_MAX_DELAY_SECONDS=2
# GROQ_TRANSCRIPTION_RETRY_TOTAL_TIMEOUT_SECONDS=20
# GROQ_TRANSCRIPTION_MAX_RETRY_AFTER_SECONDS=5

# DeepSeek API key used by the Python LangGraph agent.
DEEPSEEK_API_KEY=sk-replace_with_deepseek_api_key

# Todoist credentials are stored in Supabase Vault and referenced by
# integration_connections. Do not configure Todoist tokens in environment maps.

# --- Google Calendar ---
# OAuth *client* config from Google Cloud Console (APIs & Services > Credentials,
# "Desktop app" client). Used ONLY by scripts/connect_google_calendar.py to run
# the one-time consent flow — not read at runtime. Accepts raw JSON or a path to
# the downloaded file. Keep it secret; .gitignore covers google_client_secret*.json.
# GOOGLE_OAUTH_CLIENT_SECRETS_JSON=/absolute/path/to/client_secret.json
#
# Authorized Google credentials are stored in Supabase Vault and referenced by
# integration_connections. Local token files are import-only and must be deleted
# after scripts/manage_integrations.py validates and imports them.
#
# Space-separated OAuth scopes. Defaults to full calendar access. Narrowing to
# calendar.events later forces re-consent, so decide before connecting users.
# GOOGLE_CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar

# Local server port. Defaults to 3000 if unset.
PORT=3000

# development | production
NODE_ENV=development

# Optional: override the Python LangGraph agent model.
# DEEPSEEK_MODEL=deepseek-v4-flash
# Optional: DeepSeek V4 thinking effort. DeepSeek supports high or max.
# DEEPSEEK_REASONING_EFFORT=high
# Optional: main orchestrator DeepSeek request budget/SDK behavior.
# DEEPSEEK_REQUEST_TIMEOUT_SECONDS=30.0
# DEEPSEEK_MAX_RETRY_ATTEMPTS=3
# DEEPSEEK_RETRY_MAX_DELAY_SECONDS=8.0
# DEEPSEEK_SDK_MAX_RETRIES=0                 # keep hidden SDK retries disabled
# DEEPSEEK_MAX_TOKENS=13000
# DEEPSEEK_THINKING_ENABLED=true

# --- Query router (pre-orchestrator domain classifier) ---
# Opt-in. When enabled AND TOOL_SELECTOR=router, a fast LLM classifies which
# service domains a query needs, so the orchestrator sees a slimmer prompt and
# fewer tool schemas. It is never a hard-failure path: any error/timeout falls
# back to the static selector (all tools, full prompt). ROUTER_API_KEY and
# ROUTER_MODEL/BASE_URL default to the DeepSeek values above.
# ROUTER_ENABLED=false
# TOOL_SELECTOR=static                      # static | keyword | router
# ROUTER_MODEL=deepseek-v4-flash
# ROUTER_BASE_URL=https://api.deepseek.com
# ROUTER_API_KEY=                           # falls back to DEEPSEEK_API_KEY
# ROUTER_REASONING_EFFORT=off               # router runs with reasoning off
# ROUTER_REQUEST_TIMEOUT_SECONDS=5.0        # per-attempt timeout budget
# ROUTER_MAX_RETRY_ATTEMPTS=2               # fewer than the orchestrator
# ROUTER_RETRY_MAX_DELAY_SECONDS=2.0

# --- Model router (per-turn model + reasoning selection) ---
# Dynamically picks model and reasoning effort using the query router's
# complexity label together with domain count and uncertainty. The strongest
# signal wins. Zero added latency (pure rule evaluation).
# MODEL_ROUTER_ENABLED=true
# MODEL_ROUTER_DEFAULT_MODEL=deepseek-v4-flash
# MODEL_ROUTER_DEFAULT_REASONING=high
# Defaults to DEEPSEEK_REQUEST_TIMEOUT_SECONDS when unset.
# MODEL_ROUTER_DEFAULT_TIMEOUT_SECONDS=30.0
# MODEL_ROUTER_COMPLEX_MODEL=deepseek-v4-pro
# MODEL_ROUTER_COMPLEX_REASONING=max
# MODEL_ROUTER_COMPLEX_TIMEOUT_SECONDS=90.0
# MODEL_ROUTER_MULTI_DOMAIN_REASONING=high
# MODEL_ROUTER_MULTI_DOMAIN_TIMEOUT_SECONDS=60.0

# LangSmith tracing for the Python LangGraph agent. When enabled, every /invoke
# and /resume produces one correlated trace (jarvis.invoke / jarvis.resume) with
# nested graph-node, DeepSeek, tool, and Todoist spans, grouped by thread_id and
# correlated by request_id.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_replace_with_langsmith_api_key
LANGSMITH_PROJECT=jarvis
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Privacy: raw prompts, tool args/results, completions, and reasoning content are
# hidden from LangSmith by default (safe metadata/tags are retained). These are
# set automatically; override only if you understand the exposure.
# LANGSMITH_HIDE_INPUTS=true
# LANGSMITH_HIDE_OUTPUTS=true
# Temporarily capture full payloads in traces for debugging (disables hiding):
# JARVIS_TRACE_PAYLOADS=1

# Optional logging controls.
# LOG_FORMAT=pretty is easier to read locally; LOG_FORMAT=json is better for machines.
LOG_LEVEL=debug
LOG_FORMAT=pretty


# Test configuration
# Normal unit tests do not require live credentials:
# npm test -- --runInBand

# Live Telegram smoke tests. Set true only when you want tests to hit live services.
# RUN_INTEGRATION_TESTS=true npm run test:integration -- --runInBand
RUN_INTEGRATION_TESTS=false

# Your Telegram chat ID for live Telegram send-message tests.
# You can get this from Telegram APIs or bot update payloads.
TEST_CHAT_ID=111111111

# Your Telegram user ID for live webhook-shaped update tests.
TEST_USER_ID=111111111

# Live Todoist CRUD tests:
# RUN_LIVE_TODOIST_TESTS=true npm run test:integration -- --runInBand
RUN_LIVE_TODOIST_TESTS=false

# Live LangGraph + Todoist pipeline tests:
# RUN_LIVE_LANGGRAPH_TODOIST_TESTS=true npm run test:integration -- --runInBand
RUN_LIVE_LANGGRAPH_TODOIST_TESTS=false

# Live webhook tests:
# Requires the backend to be running and NGROK_URL to route to it.
# RUN_LIVE_WEBHOOK_TESTS=true npm run test:integration -- --runInBand
RUN_LIVE_WEBHOOK_TESTS=false


venv/
