
.github/copilot-instructions.md

# Claude Code (session-local)
.claude/

# Git hooks (generated by husky install)
.husky/

# LangGraph local dev state
.langgraph_api/
langgraph.json

# Working notes (local only)
plans/
reports/

# Runtime logs
logs/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pytest_cache
# testing
/coverage
venv/

# router benchmark output (regenerated/appended on every eval run)
tests/data/router_evals/router_results.json
tests/data/router_evals/*.summary.json

# local scratch artifacts (never commit)
domain_router_runs.parquet
THREAD_MEMORY_FEATURE_PLAN.md

# python
__pycache__/
*.py[cod]

# google calendar oauth (single-user, never commit)
token.json
# per-user calendar tokens (multi-user MVP)
tokens/
!tokens/.gitkeep
credentials.json
google_client_secret*.json

# Generated onboarding dossiers contain personal data (never credentials).
/onboard/private/

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem
*\ 2.*
*\ 2/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.sample
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local scratch/debug dir
work/
