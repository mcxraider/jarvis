ARG PYTHON_IMAGE=python:3.12-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337
FROM ${PYTHON_IMAGE} AS build
WORKDIR /build
COPY requirements.runtime.txt ./
RUN --mount=type=cache,target=/root/.cache/pip pip wheel --wheel-dir=/wheels -r requirements.runtime.txt

FROM ${PYTHON_IMAGE} AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY --from=build /wheels /wheels
COPY requirements.runtime.txt ./
RUN pip install --no-cache-dir --no-index --find-links=/wheels -r requirements.runtime.txt && rm -rf /wheels && useradd --uid 10001 --create-home jarvis && mkdir -p /app/logs && chown jarvis:jarvis /app/logs
COPY --chown=jarvis:jarvis agents ./agents
USER jarvis
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "agents.agent_api.app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--timeout-graceful-shutdown", "160", "--no-access-log"]
