LANGGRAPH_AGENT_API_KEY=replace-with-shared-secret
JARVIS_POSTGRES_DSN=postgresql://jarvis_app:replace@your-session-pooler:5432/postgres?sslmode=require
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace
LLM_PROVIDER=openai
OPENAI_API_KEY=replace
LLM_SAFETY_IDENTIFIER_SECRET=replace-with-random-secret
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=replace
LANGSMITH_PROJECT=jarvis-production

# Domain classification: Jev first, existing LLM on errors or uncertainty.
ROUTER_ENGINE=typesafe
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.14.0
# Missing TypeSafe key uses the LLM fallback. Set ROUTER_ENGINE=llm to roll back.
