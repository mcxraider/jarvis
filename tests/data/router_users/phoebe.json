{
  "display_name": "Phoebe",
  "timezone": "Asia/Singapore",
  "locale": "en-SG",
  "active_providers": ["google_calendar"],
  "custom_instructions": "Use Todoist for tasks, projects, and reminders. Use Google Calendar for events, meetings, availability, scheduling, and generic calendar requests.",
  "preferences": {
    "communication": {
      "tone": "casual",
      "verbosity": "detailed"
    },
    "routing": {
      "task_provider": "todoist",
      "event_provider": "google_calendar",
      "calendar_usage": "default"
    },
    "domains": {
      "todoist": {
        "usage": "tasks_todos_reminders",
        "default_for": ["tasks", "projects"]
      },
      "google_calendar": {
        "usage": "events_meetings_time_related_items",
        "event_category_defaults": {
          "work": "google_calendar",
          "social": "google_calendar",
          "personal": "google_calendar"
        }
      }
    }
  }
}
