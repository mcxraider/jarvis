{
  "display_name": "Jerry",
  "timezone": "Asia/Singapore",
  "locale": "en-SG",
  "active_providers": ["todoist", "google_calendar"],
  "custom_instructions": "Use Todoist for tasks, projects, and reminders. Use Todoist for events, meetings, availability, and scheduling too. Generic calendar requests go to Todoist. Only use Google Calendar when explicitly named.",
  "preferences": {
    "communication": {
      "tone": "casual",
      "verbosity": "concise"
    },
    "routing": {
      "task_provider": "todoist",
      "event_provider": "todoist",
      "calendar_usage": "explicit_only"
    },
    "domains": {
      "todoist": {
        "usage": "tasks_and_scheduling",
        "default_for": ["tasks", "projects", "events", "scheduling"]
      },
      "google_calendar": {
        "usage": "explicit_only",
        "event_category_defaults": {}
      }
    }
  }
}
