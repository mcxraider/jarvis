# Public endpoint. Point this DNS name at the server's static public IP.
PUBLIC_DOMAIN=jarvis.example.com
NGROK_URL=https://${PUBLIC_DOMAIN}

# Telegram webhook service.
BOT_TOKEN=1234567890:replace_with_telegram_bot_token
TELEGRAM_SECRET_TOKEN=replace_with_a_long_random_secret
TELEGRAM_RICH_MESSAGES=true
GROQ_API_KEY=gsk-replace_with_groq_api_key
GROQ_TRANSCRIPTION_REQUEST_TIMEOUT_SECONDS=12
GROQ_TRANSCRIPTION_MAX_RETRY_ATTEMPTS=2
GROQ_TRANSCRIPTION_RETRY_MAX_DELAY_SECONDS=2
GROQ_TRANSCRIPTION_RETRY_TOTAL_TIMEOUT_SECONDS=20
GROQ_TRANSCRIPTION_MAX_RETRY_AFTER_SECONDS=5

# Internal Node-to-agent authentication. Use the same long random value in both
# containers; Compose passes this file to both services.
LANGGRAPH_AGENT_API_KEY=replace_with_a_long_random_agent_api_key

# LangGraph model service.
DEEPSEEK_API_KEY=sk-replace_with_deepseek_api_key
DEEPSEEK_MODEL=deepseek-v4-flash
JARVIS_USER_TIMEZONE=Asia/Singapore

# Supabase Singapore transaction pooler (port 6543). Use distinct runtime users
# when available. Python/libpq uses sslmode=require; Node pg uses no-verify.
AGENT_POSTGRES_DSN=postgresql://agent_user.project_ref:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
WEB_POSTGRES_DSN=postgresql://web_user.project_ref:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=no-verify
JARVIS_CHECKPOINT_BACKEND=postgres
JARVIS_RUN_CHECKPOINT_SETUP=false
JARVIS_MAX_CONCURRENT_RUNS=8
JARVIS_SUMMARIZER_MAX_CONCURRENCY=4
TELEGRAM_PENDING_STORE=postgres
TELEGRAM_GATE_STORE=postgres

# Shared Todoist HTTP transport limits. OAuth tokens are still attached per request.
TODOIST_HTTP_TIMEOUT_SECONDS=30
TODOIST_HTTP_MAX_KEEPALIVE_CONNECTIONS=10
TODOIST_HTTP_MAX_CONNECTIONS=20

# Production runtime and bounded structured logging.
NODE_ENV=production
LOG_LEVEL=info
LOG_FORMAT=json
JARVIS_RUN_FILE_LOG=true

# Optional privacy-preserving LangSmith tracing.
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=lsv2_replace_with_langsmith_api_key
# LANGSMITH_PROJECT=jarvis
