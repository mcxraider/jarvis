# Node/Express service: Telegram webhook, audio transcode (FFmpeg), Groq transcription.
# Two stages: compile TS in `build`, ship prod deps only in `runtime`.

# ---- build stage: compile TS -> dist/ ----
FROM node:20-slim AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY tsconfig.json ./
COPY src ./src
RUN npm run build            # prebuild cleans dist/, then tsc

# ---- runtime stage: prod deps only ----
FROM node:20-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
# Reinstall prod deps here so @ffmpeg-installer/ffmpeg fetches the binary for
# THIS platform. Never copy node_modules across stages/architectures.
COPY package*.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=build /app/dist ./dist
RUN mkdir -p logs           # winston writes logs/app.log etc. (src/utils/logger.ts)
EXPOSE 3000
CMD ["node", "dist/server.js"]
