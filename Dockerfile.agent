# Python/uvicorn service: LangGraph loop, DeepSeek, Todoist tool execution.
# `agents` is a namespace package (no __init__.py), so PYTHONPATH=/app makes
# `agents.api:app` resolvable.

FROM python:3.12-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY agents ./agents
EXPOSE 8000
# 0.0.0.0 (not 127.0.0.1) so the `web` container can reach it over the Docker network.
CMD ["uvicorn", "agents.api:app", "--host", "0.0.0.0", "--port", "8000"]
